# Application
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:8080
SESSION_SECRET=replace_with_a_long_random_secret

# Database
DB_HOST=localhost
DB_PORT=5434
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=personalized_tourist_guide
DB_LOGGING=false

# Google OAuth - optional
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:5000/auth/google/callback

# Google Maps
# Use a restricted browser key in frontend/public/config.js for map rendering.
# Use a server-side key here for geocoding requests.
GOOGLE_MAPS_SERVER_API_KEY=your_google_maps_server_api_key

# AI provider: mock | ollama | openai
# mock is the default and does not require paid APIs.
TRAVEL_AI_PROVIDER=mock

# Local model provider - optional
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# OpenAI provider - optional
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4o-mini
