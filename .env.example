# Application
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:8080
CORS_ORIGINS=http://localhost:8080
JSON_BODY_LIMIT=10mb
HEALTHCHECK_TIMEOUT_MS=3000
SESSION_SECRET=change_me_for_local_development_only
SESSION_COOKIE_SAMESITE=lax

# Database - host values for local npm scripts
# DATABASE_URL can be used in production instead of the individual DB_* fields.
DATABASE_URL=
# Docker Compose overrides DB_HOST/DB_PORT internally for the backend service.
DB_HOST=localhost
DB_PORT=5434
DB_USER=postgres
DB_PASSWORD=ptg_dev_password
DB_NAME=personalized_tourist_guide
DB_LOGGING=false
DB_SYNC_ALTER=false

# Google OAuth - optional. Leave empty to disable Google login locally.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/auth/google/callback

# Google Maps
# Use a restricted browser key in frontend/public/config.js for map rendering.
# Use a server-side key here only when geocoding itinerary places.
GOOGLE_MAPS_SERVER_API_KEY=
GEOCODING_TIMEOUT_MS=7000

# AI provider: mock | ollama | openai
# mock is the default and does not require paid APIs.
TRAVEL_AI_PROVIDER=mock
AI_PROVIDER_TIMEOUT_MS=20000

# Local model provider - optional
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# OpenAI provider - optional. Leave empty unless TRAVEL_AI_PROVIDER=openai.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
