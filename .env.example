# Application
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:8080
CORS_ORIGINS=http://localhost:8080
FRONTEND_API_BASE_URL=http://localhost:5000
JSON_BODY_LIMIT=10mb
HEALTHCHECK_TIMEOUT_MS=3000
SESSION_SECRET=change_me_for_local_development_only
SESSION_COOKIE_SAMESITE=lax

# Database - host values for local npm scripts
# DATABASE_URL can be used in production instead of the individual DB_* fields.
DATABASE_URL=
# Docker Compose overrides DB_HOST/DB_PORT internally for the backend service.
DB_HOST=localhost
DB_PORT=5434
DB_USER=postgres
DB_PASSWORD=ptg_dev_password
DB_NAME=personalized_tourist_guide
DB_LOGGING=false
# Local development may use alter=true. Keep false in production and use explicit migrations there.
DB_SYNC_ALTER=true

# Google OAuth - optional. Configure these values to enable Google sign-in.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/auth/google/callback

# Google Maps Platform - optional for local development.
# When the browser key is empty, the UI keeps the itinerary available as a list fallback.
# Browser key: restrict by HTTP referrer and enable Maps JavaScript API + Directions API.
GOOGLE_MAPS_BROWSER_API_KEY=
# Server key: restrict by API scope and enable Geocoding API.
GOOGLE_MAPS_SERVER_API_KEY=
GEOCODING_TIMEOUT_MS=7000

# Google Routes API - optional backend adapter for distance/duration metadata.
GOOGLE_ROUTES_API_KEY=
GOOGLE_ROUTES_TIMEOUT_MS=8000

# Google Places API - optional backend adapter for richer place data.
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACES_TIMEOUT_MS=8000

# AI provider.
# Keep the key empty only when you want the local fallback instead of a live AI itinerary.
TRAVEL_AI_PROVIDER=openai
AI_PROVIDER_TIMEOUT_MS=20000

# OpenAI provider for itinerary generation. Use gpt-4o-mini for low-cost video recordings.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional local test seed account. Never reuse these values in production.
DEMO_USER_EMAIL=demo@example.com
DEMO_USER_PASSWORD=Password123!
DEMO_USER_NAME=Demo Traveller
