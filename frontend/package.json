{
  "name": "personalized-tourist-guide-ai-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Static JavaScript/Rollup frontend for Personalized Tourist Guide AI.",
  "scripts": {
    "build": "node ../node_modules/rollup/dist/bin/rollup -c",
    "dev": "node ../node_modules/rollup/dist/bin/rollup -c -w",
    "start": "node server.js",
    "check:syntax": "node ../scripts/check-syntax.js frontend"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "rollup": "^4.62.2",
    "rollup-plugin-livereload": "^2.0.5"
  },
  "engines": {
    "node": ">=18"
  }
}
